{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-drupal-guidance.invalid/schemas/features.schema.json",
  "title": "Notable Drupal core APIs by version",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "as_of", "sources", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "generated": { "type": "string", "format": "date" },
    "as_of": { "type": "string", "format": "date" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "category", "introduced_in", "change_record_url", "source_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "category": { "enum": ["hooks", "plugins", "dependency-injection", "routing", "frontend", "theming", "recipes", "config", "entity", "testing", "tooling", "performance", "other"] },
        "introduced_in": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "First stable release that ships the API." },
        "api": { "type": "array", "items": { "type": "string" }, "description": "Symbols an agent would write: attribute classes, service ids, file names." },
        "replaces": { "type": "array", "items": { "type": "string" }, "description": "Legacy patterns or deprecation ids this supersedes." },
        "change_record_url": { "type": "string", "pattern": "^https://www\\.drupal\\.org/node/\\d+$" },
        "source_url": { "type": "string", "pattern": "^https://" },
        "notes": { "type": "string" }
      }
    }
  }
}
