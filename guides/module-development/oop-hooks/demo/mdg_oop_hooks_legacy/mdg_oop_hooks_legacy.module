<?php

/**
 * @file
 * Procedural wrappers for core versions before 11.1.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\mdg_oop_hooks_legacy\Hook\MdgOopHooksLegacyHooks;

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function mdg_oop_hooks_legacy_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(MdgOopHooksLegacyHooks::class)->userLoginFormAlter($form, $form_state, $form_id);
}
