<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="color-scheme" content="light dark">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
<link rel="stylesheet" href="/assets/site.css">
<script src="/assets/site.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site">
  <div class="wrap">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav class="main" aria-label="Main">
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/guides/"{% if page.url == "/guides/" or page.url.startsWith("/guides/") and page.url != "/guides/" %} aria-current="page"{% endif %}>Guides</a></li>
        <li><a href="/contribute/"{% if page.url == "/contribute/" %} aria-current="page"{% endif %}>Contribute</a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a></li>
      </ul>
    </nav>
    <button type="button" id="theme-toggle" hidden>Theme</button>
  </div>
</header>
<main id="main" class="wrap" tabindex="-1">
{{ content | safe }}
</main>
<footer class="site">
  <div class="wrap">
    <p>Modern Drupal Guidance is a fork of <a href="{{ site.upstream }}">Modern Web Guidance</a> by Google Chrome, licensed Apache-2.0. Not affiliated with or endorsed by Google or the Drupal Association. <a href="/about/">About</a></p>
  </div>
</footer>
</body>
</html>
